# ConsiliumAI Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# SUPABASE
# =============================================================================

# Public Supabase URL (used in client-side code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase anon key (used in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Supabase URL (can be same as public)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service key (server-side only, keep secret!)
SUPABASE_SERVICE_KEY=your-service-key

# =============================================================================
# GOHIGHLEVEL (GHL)
# =============================================================================

# GHL API key for contact sync
GHL_API_KEY=your-ghl-api-key

# GHL location ID
GHL_LOCATION_ID=your-location-id

# GHL calendar ID for booking
GHL_CALENDAR_ID=your-calendar-id

# =============================================================================
# PDF GENERATION
# =============================================================================

# Base URL for PDF generation (your deployed site URL)
PDF_BASE_URL=https://consiliumai.co

# =============================================================================
# SANITY CMS
# =============================================================================

# Sanity project ID (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id

# Sanity dataset name (public)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity webhook secret for revalidation
SANITY_WEBHOOK_SECRET=your-webhook-secret

# Sanity API token for preview/drafts (optional, for preview mode)
SANITY_API_TOKEN=your-sanity-api-token

# GHL Calendar ID (public, for booking widget)
NEXT_PUBLIC_GHL_CALENDAR_ID=your-calendar-id

# =============================================================================
# OPTIONAL / DEVELOPMENT
# =============================================================================

# Enable debug logging
# DEBUG=true

# Override base URL for local PDF generation
# PDF_BASE_URL=http://localhost:3000
